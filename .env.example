# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file — it is excluded by .gitignore.

# Groq API key (https://console.groq.com/keys)
# Starts with gsk_
GROQ_API_KEY=gsk_your_key_here

# Recipient inbox for triaged alerts
EMAIL_TO=you@example.com

# ---- Optional overrides ----
# Path to Wazuh's JSON alerts file (default: /var/ossec/logs/alerts/alerts.json)
# ALERTS_FILE=/var/ossec/logs/alerts/alerts.json

# How often to check for new alerts, in seconds (default: 5)
# POLL_INTERVAL=5

# Minimum Wazuh rule level to triage (default: 5)
# MIN_LEVEL=5

# Groq model name — must be a currently active Groq model
# GROQ_MODEL=openai/gpt-oss-120b
